# Copy to .env for local development. None of these are secrets.

# Where `npm run dev` forwards /api (default https://api.qinvi.id; a local qinvi-be: http://localhost:3000)
VITE_API_PROXY_TARGET=https://api.qinvi.id

# API base the built site calls. Leave unset for dev/Vercel ('/api', proxied); the VPS build sets
# https://api.qinvi.id/api (see .github/workflows/deploy.yml).
# VITE_API_BASE_URL=https://api.qinvi.id/api

# Wedding shown when the URL has no slug (qinvi-be: npm run db:seed:timeless-forest)
VITE_DEFAULT_SLUG=tema-timeless-forest
